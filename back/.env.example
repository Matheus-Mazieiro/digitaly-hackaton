# Backend (Go) — variáveis de ambiente
# Copie para .env e preencha (o app lê via os.Getenv; use `export` ou direnv).

# Porta do servidor HTTP
PORT=8080

# Conexão com o PostgreSQL
DATABASE_URL=postgres://digitaly:digitaly@localhost:5432/digitaly

# OpenAI (usado no pipeline de transcrição + resumo)
OPENAI_API_KEY=

# E-mail transacional (2FA / validação)
EMAIL_FROM=no-reply@digitalyhub.com
